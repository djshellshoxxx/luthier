# Read by cpack once per generator (CPACK_PROJECT_CONFIG_FILE), after the
# command line's -D values. Picks the component set that matches the layout
# the generator wants; see Packaging.cmake.
#
#   cpack -G DEB                                    system layout
#   cpack -G TGZ                                    flat tree, everything
#   cpack -G TGZ -D LUTHIER_STANDALONE_ONLY=ON      flat tree, no VST3

if (CPACK_GENERATOR STREQUAL "DEB")
    set(CPACK_COMPONENTS_ALL sys_vst3 sys_standalone sys_content sys_desktop sys_licences)
    set(CPACK_COMPONENT_INCLUDE_TOPLEVEL_DIRECTORY OFF)   # paths are absolute in a .deb
    if (LUTHIER_STANDALONE_ONLY)
        message(FATAL_ERROR "The standalone-only bundle is a tarball; use -G TGZ")
    endif()
else()
    set(CPACK_COMPONENTS_ALL tgz_vst3 tgz_standalone tgz_content tgz_scripts)
    set(CPACK_COMPONENT_INCLUDE_TOPLEVEL_DIRECTORY ON)    # the tarball unpacks to one folder
    if (LUTHIER_STANDALONE_ONLY)
        list(REMOVE_ITEM CPACK_COMPONENTS_ALL tgz_vst3)
        set(CPACK_PACKAGE_FILE_NAME "@LUTHIER_PKG_BASENAME@-standalone")
        set(CPACK_ARCHIVE_FILE_NAME "@LUTHIER_PKG_BASENAME@-standalone")
    endif()
endif()
